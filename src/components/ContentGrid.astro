---
import { getInventory } from '../data/inventory';

const currentLocale = (Astro.currentLocale || 'es') as 'es' | 'en';
const locale = currentLocale;
const inventory = getInventory(currentLocale);
---

<section class="terminal-station-section" id="terminal-station" aria-label="Terminal interactiva">
	<div class="terminal-shell" id="term-shell">
		<!-- CRT Scanline overlay effect -->
		<div class="crt-scanlines" aria-hidden="true"></div>

		<!-- Terminal Window Top Bar -->
		<div class="term-window-bar font-mono">
			<div class="term-traffic">
				<span class="term-dot dot-red" id="btn-term-clear" title="Clear terminal"></span>
				<span class="term-dot dot-yellow" title="Reset"></span>
				<span class="term-dot dot-green" title="Status online"></span>
			</div>
			<div class="term-title">
				<span class="term-glow-icon">📡</span>
				<span>malibb@deck:~ (zsh)</span>
			</div>
			<span class="term-status neon-cyan">[ ONLINE ]</span>
		</div>

		<!-- Quick Macro Bar for fast clicking on mobile or desktop -->
		<div class="term-macros-bar font-mono">
			<span class="macro-label">MACROS:</span>
			<div class="macro-chips-wrap">
				<button type="button" class="term-macro" data-cmd="help" title={locale === 'es' ? 'Mostrar guía de comandos' : 'Show command guide'}>help</button>
				<button type="button" class="term-macro" data-cmd="calendar" title={locale === 'es' ? '📅 Agendar mentoría 1:1 en Google Calendar' : '📅 Book 1:1 mentorship session'}>mentorías</button>
				<button type="button" class="term-macro" data-cmd="scopely" title={locale === 'es' ? 'Inspeccionar experiencia en Scopely' : 'Inspect Scopely experience'}>scopely</button>
				<button type="button" class="term-macro" data-cmd="lootmint" title={locale === 'es' ? 'Inspeccionar proyecto Lootmint Game-Fi' : 'Inspect Lootmint Game-Fi project'}>lootmint</button>
				<button type="button" class="term-macro" data-cmd="sabbatical" title={locale === 'es' ? 'Inspeccionar Pausa Intencional 2026' : 'Inspect 2026 Sabbatical'}>sabbatical</button>
				<button type="button" class="term-macro" data-cmd="devf" title={locale === 'es' ? 'Inspeccionar trayectoria en DEV.F' : 'Inspect DEV.F trajectory'}>devf</button>
				<button type="button" class="term-macro" data-cmd="teaching" title={locale === 'es' ? 'Inspeccionar labor docente y liderazgo' : 'Inspect teaching & leadership'}>teaching</button>
				<button type="button" class="term-macro" data-cmd="community" title={locale === 'es' ? 'Inspeccionar rol en comunidades tech' : 'Inspect tech community roles'}>community</button>
				<button type="button" class="term-macro" data-cmd="stack" title={locale === 'es' ? 'Ver arsenal técnico y stack' : 'View tech stack'}>stack</button>
				<button type="button" class="term-macro" data-cmd="stats" title={locale === 'es' ? 'Ver atributos del sistema' : 'View system attributes'}>stats</button>
				<button type="button" class="term-macro" data-cmd="clear" title={locale === 'es' ? 'Limpiar pantalla de la terminal' : 'Clear terminal screen'}>clear</button>
			</div>
		</div>

		<!-- Terminal Screen Log (scrollable console log buffer) -->
		<div class="term-screen font-mono" id="term-screen">
			<!-- Welcome Banner -->
			<div class="term-welcome">
				<div class="welcome-title neon-cyan">MALIBB DECK OS [v2.6.4] — (x86_64-deck-kernel)</div>
				<div class="welcome-sub text-muted">
					{currentLocale === 'es' 
						? '(c) 2026 Malinali Becerril. Todos los módulos cargados.' 
						: '(c) 2026 Malinali Becerril. All modules loaded.'}
				</div>
				<div class="welcome-hint neon-yellow">
					{currentLocale === 'es'
						? "> Escribe 'help' o haz clic en las macros arriba para explorar experiencia y proyectos."
						: "> Type 'help' or click any macro above to explore experience and projects."}
				</div>
			</div>

			<!-- Output History Log Container -->
			<div class="term-log-entries" id="term-log-entries"></div>

			<!-- Active Interactive Command Line -->
			<div class="term-prompt-active">
				<span class="prompt-user neon-cyan">malibb@deck:~$</span>
				<input
					type="text"
					id="term-input"
					autocomplete="off"
					spellcheck="false"
					placeholder={currentLocale === 'es' ? "escribe 'help', 'scopely', 'stats'..." : "type 'help', 'scopely', 'stats'..."}
				/>
				<button type="button" class="term-exec-btn font-mono" id="term-exec-btn">EXEC</button>
			</div>
		</div>
	</div>
</section>

<!-- Data payload & Terminal Engine -->
<script define:vars={{ inventoryData: inventory, locale: currentLocale }}>
	function initInteractiveTerminal() {
		const termShell = document.getElementById('term-shell');
		const termScreen = document.getElementById('term-screen');
		const logEntries = document.getElementById('term-log-entries');
		const termInput = document.getElementById('term-input');
		const execBtn = document.getElementById('term-exec-btn');
		const macroBtns = document.querySelectorAll('.term-macro');
		const btnClear = document.getElementById('btn-term-clear');

		if (!termInput || !logEntries) return;

		let history = [];
		let historyIndex = -1;

		function scrollToBottom() {
			if (termScreen) {
				termScreen.scrollTop = termScreen.scrollHeight;
			}
		}

		// Focus input when clicking anywhere on the terminal window
		termShell?.addEventListener('click', (e) => {
			if (!e.target.closest('.term-macro') && !e.target.closest('a')) {
				termInput.focus();
			}
		});

		function executeCommand(raw) {
			const cmd = raw.trim();
			if (!cmd) return;

			// Add to history
			history.push(cmd);
			historyIndex = history.length;

			const query = cmd.toLowerCase();

			// Echo command line into log
			const entryEl = document.createElement('div');
			entryEl.className = 'term-entry';

			const promptEl = document.createElement('div');
			promptEl.className = 'cmd-echo-row';
			promptEl.innerHTML = `<span class="echo-prompt neon-cyan">malibb@deck:~$</span> <span class="echo-cmd">${escapeHtml(cmd)}</span>`;
			entryEl.appendChild(promptEl);

			const outputEl = document.createElement('div');
			outputEl.className = 'cmd-output-block';

			// Command handling
			if (query === 'clear' || query === 'cls') {
				logEntries.innerHTML = '';
				termInput.value = '';
				scrollToBottom();
				return;
			}

			if (query === 'help') {
				outputEl.innerHTML = `
					<div class="help-box">
						<div class="help-title neon-yellow">${locale === 'es' ? '// COMANDOS DISPONIBLES:' : '// AVAILABLE COMMANDS:'}</div>
						<div class="help-grid">
							<div><strong class="neon-cyan">calendar</strong> - ${locale === 'es' ? 'Agendar sesión de mentoría estratégica 1:1 en Google Calendar' : 'Book a 1:1 strategic mentorship session on Google Calendar'}</div>
							<div><strong class="neon-cyan">scopely</strong> - ${locale === 'es' ? 'Chat Discord Java (+500K DAU) & servidores Unity C#' : 'Discord chat in Java (+500K DAU) & Unity C# game servers'}</div>
							<div><strong class="neon-cyan">lootmint</strong> - ${locale === 'es' ? 'MVP Game-Fi, economía shards & AWS (NestJS, Next.js)' : 'Game-Fi MVP, shard economy & AWS (NestJS, Next.js)'}</div>
							<div><strong class="neon-cyan">sabbatical</strong> - ${locale === 'es' ? 'Pausa Intencional 2026, Mentoría Estratégica & GenAI' : '2026 Sabbatical Oasis, Strategic Mentorship & GenAI'}</div>
							<div><strong class="neon-cyan">devf</strong> - ${locale === 'es' ? 'Escaló plataforma EdTech a 2,500+ alumnos & GCP pipelines' : 'Scaled EdTech platform to 2,500+ students & GCP CRM'}</div>
							<div><strong class="neon-cyan">teaching</strong> - ${locale === 'es' ? 'Lead Mentor TECNOLOchicas & Coordinadora 50+ Senseis' : 'Lead Mentor TECNOLOchicas & 50+ Senseis Coordinator'}</div>
							<div><strong class="neon-cyan">community</strong> - ${locale === 'es' ? 'Google for Startups Accelerator Mentor & WTM Ambassador' : 'Google for Startups Accelerator Mentor & WTM Ambassador'}</div>
							<div><strong class="neon-cyan">stack</strong> - ${locale === 'es' ? 'Arsenal Técnico Políglota & Ing. Sistemas ESCOM IPN' : 'Polyglot Tech Arsenal & B.S. ESCOM IPN'}</div>
							<div><strong class="neon-cyan">stats</strong> - ${locale === 'es' ? 'Atributos de sistema (Scale 95%, Systems 98%, Community 99%)' : 'System attributes (Scale 95%, Systems 98%, Community 99%)'}</div>
							<div><strong class="neon-cyan">all</strong> - ${locale === 'es' ? 'Muestra todo el historial de experiencia' : 'Display full experience log'}</div>
							<div><strong class="neon-cyan">clear</strong> - ${locale === 'es' ? 'Limpia la pantalla de la terminal' : 'Clear terminal output buffer'}</div>
						</div>
					</div>
				`;
			} else if (query === 'calendar' || query === 'mentorias' || query === 'mentorías' || query === 'booking' || query === 'mentoria') {
				outputEl.innerHTML = `
					<div class="item-log-card" style="border-color: #00f5ff; background: rgba(0, 245, 255, 0.04);">
						<div class="card-head">
							<span class="c-icon">📅</span>
							<div class="c-meta">
								<div class="c-title-row">
									<h3 class="c-title">${locale === 'es' ? 'Calendario de Mentorías 1:1' : '1:1 Mentorship Calendar'}</h3>
									<span class="c-rarity rarity-mythic">${locale === 'es' ? 'SESIONES ESTRATÉGICAS' : 'STRATEGIC SESSIONS'}</span>
								</div>
								<div class="c-sub">Google Calendar Appointment Scheduling</div>
							</div>
						</div>
						<p class="c-desc">
							${locale === 'es'
								? 'Agenda una sesión 1:1 con Malinali sobre Ingeniería de Software, Microservicios, Arquitectura Backend, Liderazgo Técnico o Mentoría de Carrera.'
								: 'Schedule a 1:1 session with Malinali on Software Engineering, Microservices, Backend Architecture, Tech Leadership or Career Mentorship.'}
						</p>
						<div class="c-tags" style="margin-top: 0.5rem;">
							<a href="https://calendar.app.google/494u6qZ5PayiiCsj6" target="_blank" rel="noopener noreferrer" style="color: #00f5ff; text-decoration: none; font-weight: 700; background: rgba(0, 245, 255, 0.12); border: 1px solid rgba(0, 245, 255, 0.4); padding: 0.4rem 0.95rem; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.2s ease;">
								<span>${locale === 'es' ? '📅 Abrir Calendario de Mentorías en Google Calendar →' : '📅 Open Mentorship Google Calendar →'}</span>
							</a>
						</div>
					</div>
				`;
			} else if (query === 'stats') {

				outputEl.innerHTML = `
					<div class="stats-box">
						<div class="stats-head neon-yellow">${locale === 'es' ? '// RATINGS DE ATRIBUTOS DEL SISTEMA:' : '// SYSTEM ATTRIBUTE RATINGS:'}</div>
						<div class="stat-line">
							<span class="s-name">STR (Scale & Concurrency):</span>
							<div class="s-bar"><div class="s-fill" style="width: 95%; background: #ffe600; box-shadow: 0 0 8px #ffe600;"></div></div>
							<span class="s-val neon-yellow">95%</span>
						</div>
						<div class="stat-line">
							<span class="s-name">INT (Systems & Architecture):</span>
							<div class="s-bar"><div class="s-fill" style="width: 98%; background: #00f5ff; box-shadow: 0 0 8px #00f5ff;"></div></div>
							<span class="s-val neon-cyan">98%</span>
						</div>
						<div class="stat-line">
							<span class="s-name">CHA (Community & Mentorship):</span>
							<div class="s-bar"><div class="s-fill" style="width: 99%; background: #ff007f; box-shadow: 0 0 8px #ff007f;"></div></div>
							<span class="s-val neon-pink">99%</span>
						</div>
						<div class="stat-line">
							<span class="s-name">AGI (Full Stack & GenAI):</span>
							<div class="s-bar"><div class="s-fill" style="width: 92%; background: #ccff00; box-shadow: 0 0 8px #ccff00;"></div></div>
							<span class="s-val neon-lime">92%</span>
						</div>
					</div>
				`;
			} else if (query === 'all' || query === 'cv') {
				outputEl.innerHTML = inventoryData.map((item) => renderItemCard(item)).join('');
			} else {
				// Search matching inventory item
				const matched = inventoryData.find(
					(x) => query.includes(x.id) || x.title.toLowerCase().includes(query.replace('inspect ', ''))
				);

				if (matched) {
					outputEl.innerHTML = renderItemCard(matched);
				} else {
					outputEl.innerHTML = `
						<div class="err-line text-error">
							${locale === 'es' ? `zsh: comando no encontrado: '${escapeHtml(cmd)}'. Escribe 'help' para ver los comandos disponibles.` : `zsh: command not found: '${escapeHtml(cmd)}'. Type 'help' for available commands.`}
						</div>
					`;
				}
			}

			entryEl.appendChild(outputEl);
			logEntries.appendChild(entryEl);

			termInput.value = '';
			scrollToBottom();
		}

		function renderItemCard(item) {
			const rarityClass = `rarity-${item.rarity.toLowerCase()}`;
			const telemetryChips = item.stats
				.map((s) => `<div class="t-chip"><span class="t-k">${s.name}:</span><strong class="t-v neon-cyan">${s.val}</strong></div>`)
				.join('');
			const tagsPills = item.tags
				.map((t) => `<span class="tag-pill">${t}</span>`)
				.join('');

			return `
				<div class="item-log-card">
					<div class="card-head">
						<span class="c-icon">${item.icon}</span>
						<div class="c-meta">
							<div class="c-title-row">
								<h3 class="c-title">${item.title}</h3>
								<span class="c-rarity ${rarityClass}">${item.rarityLabel}</span>
							</div>
							<div class="c-sub">${item.type} · <span class="c-metric">${item.metric}</span></div>
						</div>
					</div>
					<p class="c-desc">${item.description}</p>
					<div class="c-lore"><strong class="neon-yellow">// PERK:</strong> ${item.lore}</div>
					<div class="c-telemetry">${telemetryChips}</div>
					<div class="c-tags">${tagsPills}</div>
				</div>
			`;
		}

		function escapeHtml(str) {
			return str
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#039;');
		}

		// Macro clicks
		macroBtns.forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const cmd = btn.dataset.cmd;
				if (cmd) executeCommand(cmd);
			});
		});

		// Clear dot
		btnClear?.addEventListener('click', (e) => {
			e.stopPropagation();
			executeCommand('clear');
		});

		// Exec button click
		execBtn?.addEventListener('click', () => {
			executeCommand(termInput.value);
		});

		// Keydown events
		termInput?.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				executeCommand(termInput.value);
			} else if (e.key === 'ArrowUp') {
				if (history.length > 0 && historyIndex > 0) {
					historyIndex--;
					termInput.value = history[historyIndex];
				}
			} else if (e.key === 'ArrowDown') {
				if (historyIndex < history.length - 1) {
					historyIndex++;
					termInput.value = history[historyIndex];
				} else {
					historyIndex = history.length;
					termInput.value = '';
				}
			}
		});
	}

	initInteractiveTerminal();
	document.addEventListener('astro:after-swap', initInteractiveTerminal);
</script>

<style>
	.terminal-station-section {
		position: relative;
		z-index: 2;
		padding: 0.5rem 1.5rem 4rem;
		max-width: 960px;
		margin: 0 auto;
		width: 100%;
		box-sizing: border-box;
	}

	.terminal-shell {
		position: relative;
		background: rgba(10, 14, 22, 0.94);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(0, 245, 255, 0.25);
		border-radius: 1rem;
		overflow: hidden;
		box-shadow:
			0 16px 48px rgba(0, 0, 0, 0.8),
			0 0 25px rgba(0, 245, 255, 0.12),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.crt-scanlines {
		position: absolute;
		inset: 0;
		background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.22) 50%);
		background-size: 100% 4px;
		pointer-events: none;
		z-index: 10;
		opacity: 0.2;
	}

	/* Title Bar */
	.term-window-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 1.25rem;
		background: rgba(8, 10, 16, 0.98);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		font-size: 0.8125rem;
		position: relative;
		z-index: 2;
	}

	.term-traffic {
		display: flex;
		gap: 0.45rem;
	}

	.term-dot {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		cursor: default;
	}

	.dot-red { background: #ff5f56; cursor: pointer; }
	.dot-yellow { background: #ffbd2e; }
	.dot-green { background: #27c93f; }

	.term-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #cbd5e1;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.term-status {
		font-size: 0.75rem;
		font-weight: 700;
	}

	/* Macros Row */
	.term-macros-bar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.6rem 1.25rem;
		background: rgba(14, 18, 28, 0.75);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		font-size: 0.6875rem;
		position: relative;
		z-index: 2;
	}

	.macro-label {
		color: #64748b;
		font-weight: 700;
		letter-spacing: 0.05em;
	}

	.macro-chips-wrap {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.term-macro {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: #94a3b8;
		padding: 0.18rem 0.55rem;
		border-radius: 4px;
		font-size: 0.6875rem;
		font-family: inherit;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.term-macro:hover {
		color: #00f5ff;
		border-color: rgba(0, 245, 255, 0.5);
		background: rgba(0, 245, 255, 0.1);
	}

	/* Terminal Screen */
	.term-screen {
		position: relative;
		z-index: 2;
		padding: 1.25rem;
		min-height: 320px;
		max-height: 520px;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 245, 255, 0.3) rgba(10, 14, 22, 0.5);
	}

	.term-screen::-webkit-scrollbar {
		width: 6px;
	}

	.term-screen::-webkit-scrollbar-thumb {
		background: rgba(0, 245, 255, 0.3);
		border-radius: 4px;
	}

	/* Welcome message */
	.term-welcome {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.8125rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
	}

	.welcome-title {
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.welcome-sub {
		color: #64748b;
	}

	.welcome-hint {
		margin-top: 0.2rem;
		font-weight: 600;
	}

	/* Log entries */
	.term-log-entries {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	:global(.term-entry) {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		animation: termStreamIn 0.22s ease-out forwards;
	}

	@keyframes termStreamIn {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	:global(.cmd-echo-row) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
	}

	:global(.echo-prompt) {
		font-weight: 700;
	}

	:global(.echo-cmd) {
		color: #ffffff;
		font-weight: 600;
	}

	:global(.cmd-output-block) {
		padding-left: 0.5rem;
	}

	/* Error line */
	:global(.err-line) {
		color: #ff0055;
		font-size: 0.8125rem;
	}

	/* Help table */
	:global(.help-box) {
		background: rgba(14, 18, 28, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		padding: 1rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 0.8125rem;
	}

	:global(.help-title) {
		font-weight: 700;
		letter-spacing: 0.05em;
	}

	:global(.help-grid) {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		color: #94a3b8;
		line-height: 1.5;
	}

	/* Stats Output */
	:global(.stats-box) {
		background: rgba(14, 18, 28, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		padding: 1rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	:global(.stats-head) {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		margin-bottom: 0.25rem;
	}

	:global(.stat-line) {
		display: grid;
		grid-template-columns: 220px 1fr 45px;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.75rem;
	}

	:global(.s-name) {
		color: #94a3b8;
	}

	:global(.s-bar) {
		height: 8px;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 9999px;
		overflow: hidden;
	}

	:global(.s-fill) {
		height: 100%;
