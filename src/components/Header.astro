---

<header class="site-header">
	<nav class="header-dock" aria-label="Navegación de cabecera">
		<LanguagePicker />
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		top: 0;
		right: 0;
		z-index: 60;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		padding: 1.25rem 1.5rem;
		pointer-events: none;
	}

	.header-dock {
		pointer-events: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.35rem 0.65rem;
		border-radius: 9999px;
		background: rgba(16, 18, 26, 0.85);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
	}

	.header-social-links {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.header-social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: #cbd5e1;
		text-decoration: none;
		transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.header-social-btn:hover {
		background: rgba(255, 255, 255, 0.12);
		border-color: #00f5ff;
		color: #00f5ff;
		transform: translateY(-2px);
		box-shadow: 0 0 12px rgba(0, 245, 255, 0.3);
	}

	.header-divider {
		width: 1px;
		height: 18px;
		background: rgba(255, 255, 255, 0.15);
		margin: 0 0.15rem;
	}

	/* Reset nested LanguagePicker styling inside header dock */
	.header-dock :global(.language-picker) {
		background: transparent;
		border: none;
		padding: 0;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	@media (max-width: 768px) {
		.site-header {
			padding: 0.85rem 1rem;
		}

		.header-social-links {
			display: none;
		}

		.header-divider {
			display: none;
		}

		.header-dock {
			padding: 0.25rem 0.45rem;
		}
	}
</style>
