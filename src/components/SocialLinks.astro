---
const currentLocale = (Astro.currentLocale || 'es') as 'es' | 'en';

interface SocialLink {
	name: string;
	url: string;
	tooltip: string;
	svg: string;
}

const socialLinks: SocialLink[] = [
	{
		name: 'GitHub',
		url: 'https://github.com/malibb',
		tooltip: 'GitHub // @malibb',
		// GitHub Octocat SVG
		svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
	},
	{
		name: 'LinkedIn',
		url: 'https://www.linkedin.com/in/malibb/',
		tooltip: 'LinkedIn // @malibb',
		// LinkedIn SVG
		svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>`,
	},
	{
		name: currentLocale === 'es' ? 'Calendario de Mentorías' : 'Mentorship Calendar',
		url: 'https://calendar.app.google/494u6qZ5PayiiCsj6',
		tooltip: currentLocale === 'es' ? '📅 Agendar Mentoría 1:1' : '📅 Book 1:1 Mentorship',
		// Calendar SVG
		svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>`,
	},
	{
		name: 'Email',
		url: 'mailto:malinalibb98@gmail.com',
		tooltip: 'Email // malinalibb98@gmail.com',
		// Mail SVG
		svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
	},
	{
		name: 'X (Twitter)',
		url: 'https://x.com/_mesurashii',
		tooltip: 'X // @_mesurashii',
		// X / Twitter SVG
		svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
	},
	{
		name: 'Instagram',
		url: 'https://www.instagram.com/_mesurashii',
		tooltip: 'Instagram // @_mesurashii',
		// Instagram SVG
		svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
	},
];
---

<footer class="social-dock">
	<nav class="social-nav" aria-label="Redes sociales">
		{
			socialLinks.map((link) => (
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					class="social-circle"
					aria-label={link.name}
				>
					<span class="icon" set:html={link.svg} />
					<span class="social-tooltip font-mono" role="tooltip">{link.tooltip}</span>
				</a>
			))
		}
	</nav>
</footer>

<style>
	.social-dock {
		display: flex;
		justify-content: center;
		padding: 1.25rem 0 0.25rem;
		margin: 0;
		position: relative;
		z-index: 10;
		width: 100%;
	}

	@media (max-width: 768px) {
		.social-dock {
			padding: 1rem 0 0;
		}
	}

	.social-nav {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.6rem 0.9rem;
		background: rgba(16, 18, 26, 0.65);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 9999px;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
	}

	@media (max-width: 768px) {
		.social-nav {
			gap: 0.65rem;
			padding: 0.45rem 0.75rem;
		}
	}

	.social-circle {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #e5e7eb;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform, box-shadow;
	}

	@media (max-width: 768px) {
		.social-circle {
			width: 40px;
			height: 40px;
		}
	}

	.icon {
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.25s ease;
	}

	/* Tooltip flotante con estética cyberpunk/glass */
	.social-tooltip {
		position: absolute;
		bottom: calc(100% + 12px);
		left: 50%;
		transform: translateX(-50%) translateY(4px);
		background: rgba(10, 14, 22, 0.95);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(0, 245, 255, 0.4);
		box-shadow:
			0 6px 20px rgba(0, 0, 0, 0.7),
			0 0 12px rgba(0, 245, 255, 0.25);
		color: #00f5ff;
		font-family: var(--font-mono, monospace);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		padding: 0.35rem 0.7rem;
		border-radius: 6px;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
			visibility 0.2s;
		z-index: 50;
	}

	/* Flecha inferior del tooltip */
	.social-tooltip::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		border-width: 5px;
		border-style: solid;
		border-color: rgba(0, 245, 255, 0.6) transparent transparent transparent;
	}

	/* Micro-interacciones al hacer hover */
	.social-circle:hover {
		transform: translateY(-4px) scale(1.12);
		background: rgba(255, 255, 255, 0.12);
		border-color: #00f5ff;
		color: #00f5ff;
		box-shadow: 0 0 20px rgba(0, 245, 255, 0.35);
		z-index: 30;
	}

	.social-circle:hover .icon {
		transform: scale(1.08);
	}

	.social-circle:hover .social-tooltip,
	.social-circle:focus-visible .social-tooltip {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
	}

	.social-circle:active {
		transform: translateY(-1px) scale(1.05);
	}
</style>
